{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildNuke",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/.nuke/_build.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
