            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/.nuke/bin/Debug/_build.dll",
            "args": [
                "Test",
                // "--mainName",
                // "TaskTitan.Cli",
                // "--configuration",
                // "Release"
            ],
            "cwd": "${workspaceFolder}",
